{
  "name": "kamand-chat",
  "version": "1.0.0",
  "description": "Real-time one-to-one chat app for the First Commit hackathon",
  "main": "server.js",
  "scripts": {
    "setup:env": "node scripts/setup-env.js",
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check:sqlite": "node --disable-warning=ExperimentalWarning scripts/check-sqlite.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie": "^0.7.2",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.8.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
