# Copy this file to ".env" and fill in the values. NEVER commit .env to GitHub.
JWT_SECRET=change-this-to-a-long-random-string
PORT=3000

# Optional AI provider. Left blank, the assistant uses a chain of free, keyless
# APIs and needs no setup at all. Set LLM_API_KEY to use Claude instead.
LLM_API_KEY=
# Only used for Claude: the model name to request (default claude-haiku-4-5-20251001).
LLM_MODEL=
